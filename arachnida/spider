#!/usr/bin/env python3

import os
import sys
import argparse
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin, urlparse

VALID_EXTENSIONS = (".jpg", ".jpeg", ".png", ".gif", ".bmp")

def crawl(current_url, save_dir, domain, recursive, 
          depth, max_depth, visited, downloaded):
    # Base case
    if current_url in visited:
        return
    visited.add(current_url)

    print(f"Depth {depth}. Scraping {current_url}")
    try:
        response = requests.get(current_url, timeout=10)
        response.raise_for_status()
    except Exception as e:
        print("Skipped page:", current_url, e)
        return

    soup = BeautifulSoup(response.text, "html.parser")

    # Download images on page
    for img in soup.find_all("img", src=True):
        image_url = urljoin(current_url, img["src"])

        path = urlparse(image_url).path

        if not path.lower().endswith(VALID_EXTENSIONS):
            continue

        if image_url in downloaded:
            continue
        downloaded.add(image_url)

        img_name = os.path.basename(path)
        if not img_name:
            continue
        filename = os.path.join(save_dir, img_name)
        base, ext = os.path.splitext(filename)
        counter = 1
        while os.path.exists(filename):
            filename = f"{base}_{counter}{ext}"
            counter +=1
            
        try:
            data = requests.get(image_url, timeout=10)
            data.raise_for_status()
            with open(filename, "wb") as f:
                f.write(data.content)
            print("Saved:", filename)
        except Exception as e:
            print("Skipped:", image_url, e)

    # recursion step
    if recursive and depth < max_depth:
        for link in soup.find_all("a", href=True):
            next_url = urljoin(current_url, link["href"].split("#")[0])
            if urlparse(next_url).netloc == domain:
                crawl(next_url, save_dir, domain, recursive, 
                      depth + 1, max_depth, visited, downloaded)

def main():
    parser = argparse.ArgumentParser(usage="./spider [-rlp] URL")
    parser.add_argument("-r", action="store_true", help="recursive download")
    parser.add_argument("-l", type=int, default=None, help="max depth of recursion")
    parser.add_argument("-p", type=str, default="./data/", help="save path. Ex: ./images/")
    parser.add_argument("url", help="URL")

    args = parser.parse_args()
    
    if args.l is not None and not args.r:
        print("Error: -l requires -r")
        sys.exit(1)

    max_depth = args.l if args.l is not None else 5
    if max_depth < 0:
        print("Error: level must be positive")
        sys.exit(1)

    if not args.url.startswith(("http://", "https://")):
        args.url = "https://" + args.url

    domain = urlparse(args.url).netloc
    if not domain:
        print("Error: invalid URL")
        sys.exit(1)

    os.makedirs(args.p, exist_ok=True)
    visited = set()
    downloaded = set()

    crawl(args.url, args.p, domain, args.r, 0, max_depth, visited, downloaded)

if __name__== "__main__":
    main()
