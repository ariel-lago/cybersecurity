#!/usr/bin/env python3

import argparse
import os
from datetime import datetime
from PIL import Image, ExifTags

RED = "\033[91m"
GREEN = "\033[92m"
BLUE = "\033[94m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"

VALID_EXTENSIONS = (".jpg", ".jpeg", ".png", ".gif", ".bmp")

def format_value(value):
    stripped = value.strip(b"\x00").strip()
    if not stripped:
        return None
    try:
        decoded = stripped.decode("utf-8")
        if decoded.isprintable():
            return decoded
    except UnicodeDecodeError:
        pass
    return ".".join(str(b) for b in value)    

def get_and_print(ifd_data, tags = ExifTags.TAGS):
    ignored_tags = {"GPSInfo", "ExifOffset", "ExifInteroperabilityOffset", "MakerNote"}

    for tag_id, value in ifd_data.items():
        tag_name = tags.get(tag_id, tag_id)
        if tag_name in ignored_tags:
            continue
        if isinstance(value, bytes):
            value = format_value(value)
            if value is None:
                continue
        print(f"{GREEN}{tag_name}: {RESET}{value}")

def print_format_exif_data(exif_data):
    get_and_print(exif_data)
    exif_ifd = exif_data.get_ifd(ExifTags.IFD.Exif)
    get_and_print(exif_ifd)
    gps_ifd = exif_data.get_ifd(ExifTags.IFD.GPSInfo)
    get_and_print(gps_ifd, ExifTags.GPSTAGS)
    interop_ifd = exif_data.get_ifd(ExifTags.IFD.Interop)
    get_and_print(interop_ifd)

def print_extra_info(image):
    for key, value in image.info.items():
        if key == "exif":
            continue
        if isinstance(value, bytes) and len(value) > 200:
            print(f"{CYAN}{key}:{RESET} binary data of {len(value)} bytes")
            continue
        if isinstance(value, bytes):
            value = format_value(value)
        print(f"{CYAN}{key}: {RESET}{value}")

def print_basic_attributes(file_path, image):
    file_stats = os.stat(file_path)
    size_kb = file_stats.st_size / 1024
    mod_time = datetime.fromtimestamp(file_stats.st_mtime).strftime("%d.%m.%Y %H:%M:%S")
    create_time = datetime.fromtimestamp(file_stats.st_ctime).strftime("%d.%m.%Y %H:%M:%S")
    print(f"{BLUE}File Name:{RESET} {os.path.basename(file_path)}")
    print(f"{BLUE}Format: {RESET}{image.format} | Mode: {image.mode} | Dimensions: {image.width}x{image.height}")
    print(f"{BLUE}File Size: {RESET}{size_kb:.2f} KB ({file_stats.st_size} bytes)")
    print(f"{BLUE}Created / Metadata Change: {RESET}{create_time}")
    print(f"{BLUE}Last Modified: {RESET}{mod_time}")

def process_file(file_path):
    if not os.path.isfile(file_path):
        print(f"{RED}Error: {file_path} does not exist or is not a file{RESET}")
        return
    if not file_path.lower().endswith(VALID_EXTENSIONS):
        print(f"{RED}Error: {file_path} is not {VALID_EXTENSIONS}{RESET}")
        return
    try:
        with Image.open(file_path) as image:
            print(f"{BOLD}{CYAN}\nHere's the metadata found on {file_path}:\n{RESET}")
            print_basic_attributes(file_path, image)
            print_extra_info(image)

            exif_data = image.getexif()
            if exif_data:
                print_format_exif_data(exif_data)
            else:
                print(f"No EXIF data found on {file_path}")
    except Exception as e:
        print(f"{RED}Error reading {file_path}: {e}{RESET}")

def main():
    parser = argparse.ArgumentParser(usage="./scorpion FILE [FILE2 ...]")
    parser.add_argument("files", nargs='+', help="image files")

    args = parser.parse_args()
    
    for file_path in args.files:
        process_file(file_path)

if __name__== "__main__":
    main()

